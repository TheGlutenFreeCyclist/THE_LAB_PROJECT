+# INC132 / TEST: Card2-only future FIRST TEMPO DOSE (explicit owner consent).
+# This policy never changes Card3, the canonical library, INC083/INC111 issuer,
+# execution matching, ledger, calendar or production authentication.
+INC132_CARD2_FIRST_SCHEMA = 'NOVA-INC132-CARD2-FIRST-TEMPO-ONLY-1'
+_INC132_CARD2_FIRST_BASE_BUILDER = _inc132_build_integrative
+_INC132_CARD2_FIRST_BASE_VALIDATOR = _inc132_validate_integrative
+_INC132_CARD2_FIRST_BASE_UI = _v4891_prepare_snapshot_for_ui
+_INC132_CARD2_FIRST_GOALS = frozenset(('POWER_5','VO2MAX','POWER_20','TIME_TRIAL',
+                                      'POWER_1','SPRINTER','ENDURANCE_BASE'))
+_INC132_CARD2_FIRST_REASONS = {
+    'POWER_5':'supporto aerobico alla ripetibilità dei 5 minuti',
+    'VO2MAX':'sostegno aerobico al lavoro VO2 senza aggiungere HIIT',
+    'POWER_20':'sostegno al tempo sotto pressione',
+    'TIME_TRIAL':'sostegno alla continuità del pacing',
+    'POWER_1':'base aerobica complementare ai lavori anaerobici',
+    'SPRINTER':'base aerobica complementare agli sprint, non sprint aggiuntivi',
+    'ENDURANCE_BASE':'primo stimolo Tempo opzionale, distinto dal lavoro facile',
+}
+
+
+def _inc132_card2_first_build(goal, dimension, ftp_anchor, owner_user_id):
+    """Deterministic Card2 advisory. Same future-unscheduled semantics as Card3.
+
+    FTP is an owner-attested *pacing reference*, not proof of past Tempo or an
+    issuer permission. First exposure never borrows fake repeat-work receipts.
+    """
+    goal=str(goal or '').upper();dimension=str(dimension or '').upper()
+    if goal not in _INC132_CARD2_FIRST_GOALS or not dimension or not owner_user_id:
+        return None
+    # Explicit real owner binding; a tampered/missing token fails closed.
+    f=ftp_anchor if isinstance(ftp_anchor,dict) else {}
+    if not f.get('nova_inc132_owner_token'):
+        return None
+    ref=_inc132_r153_public_ftp(f,expected_owner_id=owner_user_id)
+    if (not isinstance(ref,dict) or ref.get('state')!='AVAILABLE'
+        or ref.get('owner_attested') is not True or ref.get('source')!='INTERVALS.ICU'
+        or type(ref.get('watts')) is not int or not 80<=ref['watts']<=600):
+        return None
+    # The owner-approved DTM BI prioritizes Intervals rolling FTP as the
+    # persistent pacing reference. Older formal estimates may share its date;
+    # do not silently replace the rolling estimate with that alternative.
+    ftp=ref['watts']
+    reference_date=ref.get('date')
+    rolling=f.get('current_rolling_ftp')
+    rolling_date=f.get('current_rolling_date')
+    if type(rolling) in (int,float) and math.isfinite(rolling) and 80<=rolling<=600:
+        try: latest=date.fromisoformat(str(rolling_date or '')[:10])
+        except (ValueError,TypeError):latest=None
+        if latest is not None and latest<=get_rome_now().date():
+            ftp=int(round(rolling));reference_date=latest.isoformat()
+    try: stamp=date.fromisoformat(str(reference_date or ''))
+    except (ValueError,TypeError):return None
+    if stamp>get_rome_now().date():return None
+    # Minimum controlled FIRST exposure, not a hidden progression from Z4/VO2.
+    # Conservative 80-85% FTP, round *down* to 5W, do not add false precision.
+    low=int(math.floor(ftp*.80/5)*5)
+    high=int(math.floor(ftp*.85/5)*5)
+    if not 60<=low<high<=510:return None
+    wid='INC132_C2_FIRST_TEMPO_'+goal+'_'+dimension
+    blocks=[
+        {'type':'WARMUP_EASY','seconds':900,'zone':'Z1/Z2'},
+        {'type':'TEMPO_WORK','seconds':600,'zone':'Z3','low_watts':low,'high_watts':high},
+        {'type':'RECOVERY_EASY','seconds':300,'zone':'Z1'},
+        {'type':'TEMPO_WORK','seconds':600,'zone':'Z3','low_watts':low,'high_watts':high},
+        {'type':'COOLDOWN_EASY','seconds':600,'zone':'Z1'},
+    ]
+    total=sum(x['seconds'] for x in blocks)
+    if total!=3000:return None
+    band={'schema':INC132_CARD2_FIRST_SCHEMA,'state':'PROVISIONAL_FUTURE',
+        'source':'OWNER_ATTESTED_INTERVALS_FTP_FIRST_DOSE',
+        'work_domain':'TEMPO_Z3','power_target_mode':'PROVISIONAL_RANGE',
+        'low_watts':low,'high_watts':high,'ftp_watts':ftp,
+        'reference_date':stamp.isoformat(),'reps':2,'work_seconds':600,
+        'recovery_seconds':300,'observed_repeated_work_is_direct_evidence':False,
+        'workout_specific_proof':'NOT_IMPLIED_BY_FTP',
+        'execution_clearance':'NOT_GRANTED', 'no_progression':True}
+    work={'nova_workout_id':wid,'goal_key':goal,'nova_prescription_dimension':dimension,
+        'title':'Prima dose Tempo/Z3 · 2×10 min',
+        'main_set':('15 min facile Z1/Z2; 2×10 min in Tempo/Z3 a '+
+                   str(low)+'–'+str(high)+' W, 5 min Z1 fra le ripetute; '+
+                   '10 min defaticamento Z1. Nessuna progressione automatica.'),
+        'why':_INC132_CARD2_FIRST_REASONS[goal],
+        'duration':'50 min','intensity':'TEMPO Z3 · FUTURE FIRST DOSE',
+        'power_prescription':band,
+        'session_composition':{'schema':INC132_CARD2_FIRST_SCHEMA,
+            'state':'COMPLETE_FUTURE_ADVISORY','total_seconds':total,
+            'blocks':blocks,'primary_work_seconds':1200,
+            'interval_recovery_seconds':300},
+        'session_duration_feasibility':{'state':'UNASSESSED',
+            'reason':'NO_CONFIRMED_ATHLETE_SLOT'},
+        'is_scheduled':False,'date':None,'nova_prescription_authority':False,
+        'execution_authorized':False}
+    proof={'schema':INC132_CARD2_FIRST_SCHEMA,'owner_scope':_nova_inc050_owner_scope(owner_user_id),
+           'ftp_reference_date':stamp.isoformat(), 'source':'OWNER_ATTESTED_INTERVALS_FTP',
+           'mode':'FUTURE_FIRST_EXPOSURE_NO_WORKOUT_ISSUANCE'}
+    return {'schema':INC132_DUAL_SCHEMA,'role':'CARD2',
+        'dose_kind':'FIRST_TEMPO_FTP_ADVISORY','first_dose_schema':INC132_CARD2_FIRST_SCHEMA,
+        'owner_scope':_nova_inc050_owner_scope(owner_user_id),
+        'goal_key':goal,'dimension':dimension,'workout_id':wid,
+        'workout':work,'compiled_workout_digest':_nova_inc050_workout_digest(work),
+        'origin_proof':proof,'no_calendar':True,'not_issued':True,
+        'execution_authorized':False,'duration_minutes':50,
+        'evidence_ids':[]}
+
+
+def _inc132_build_integrative(goal,dimension,evidence_ledger,ftp_anchor,road,
+                              power_model,owner_user_id):
+    # Existing verified exact-tempo path wins; no regression for any goal.
+    original,why=_INC132_CARD2_FIRST_BASE_BUILDER(goal,dimension,evidence_ledger,
+                                  ftp_anchor,road,power_model,owner_user_id)
+    if original is not None:return original,why
+    # Only this Card2 optional alternative receives the new First Dose path.
+    first=_inc132_card2_first_build(goal,dimension,ftp_anchor,owner_user_id)
+    if first is None:return None,why
+    return first,'CARD2_FIRST_DOSE_FTP_ADVISORY_UNSCHEDULED'
+
+
+def _inc132_validate_integrative(data,plan,owner_user_id,producer_request=True):
+    tempo=plan.get('inc132_integrative') if isinstance(plan,dict) else None
+    if not isinstance(tempo,dict) or tempo.get('dose_kind')!='FIRST_TEMPO_FTP_ADVISORY':
+        return _INC132_CARD2_FIRST_BASE_VALIDATOR(data,plan,owner_user_id,
+                    producer_request=producer_request)
+    if not owner_user_id or not isinstance(data,dict):return False
+    if (plan.get('inc132_dual_schema')!=INC132_DUAL_SCHEMA
+        or plan.get('status')!='COMPILED_UNSCHEDULED'
+        or tempo.get('schema')!=INC132_DUAL_SCHEMA
+        or tempo.get('first_dose_schema')!=INC132_CARD2_FIRST_SCHEMA
+        or tempo.get('role')!='CARD2'
+        or tempo.get('owner_scope')!=_nova_inc050_owner_scope(owner_user_id)
+        or tempo.get('goal_key')!=plan.get('goal_key')
+        or tempo.get('dimension')!=plan.get('dimension')
+        or tempo.get('workout_id')==plan.get('workout_id')
+        or tempo.get('no_calendar') is not True
+        or tempo.get('not_issued') is not True
+        or tempo.get('execution_authorized') is not False
+        or tempo.get('evidence_ids')!=[]):return False
+    work=tempo.get('workout')
+    if (not isinstance(work,dict) or work.get('is_scheduled') is not False
+        or work.get('date') is not None
+        or work.get('nova_prescription_authority') is not False
+        or work.get('execution_authorized') is not False
+        or tempo.get('compiled_workout_digest')!=_nova_inc050_workout_digest(work)):
+        return False
+    expected=_inc132_card2_first_build(plan.get('goal_key'),plan.get('dimension'),
+                                  data.get('ftp_anchor'),owner_user_id)
+    if expected is None:return False
+    # Full canonical JSON equality detects changed watts, IDs, duration,
+    # proof, role, date, source, owner and text. Fueling is attached *after*
+    # this stage by the original INC132 attester; it must be independently
+    # replayed rather than making the newly-attested card fail on UI reload.
+    base={k:v for k,v in tempo.items() if k!='fueling'}
+    if not hmac.compare_digest(_nova_inc051_canonical_json(base),
+                               _nova_inc051_canonical_json(expected)):
+        return False
+    if 'fueling' not in tempo:return True
+    fuel=tempo.get('fueling')
+    if not isinstance(fuel,dict):return False
+    metabolic=data.get('metabolic_context') or {}
+    try:
+        inside=_intra_fueling_strategy('THRESHOLD','INDOOR','THRESHOLD',50,
+            glycogen_pressure=metabolic.get('glycogen_pressure'),metabolic_context=metabolic)
+        outside=_intra_fueling_strategy('THRESHOLD','OUTDOOR','THRESHOLD',50,
+            glycogen_pressure=metabolic.get('glycogen_pressure'),metabolic_context=metabolic)
+    except (TypeError,ValueError,AttributeError,KeyError):return False
+    expected_fuel={'workout_id':tempo['workout_id'],
+        'source':'EXACT_COMPILED_INTEGRATIVE_TEMPO_DURATION',
+        'display':inside.get('display'),'outdoor_display':outside.get('display'),
+        'total_minutes_example':50,'read_only':True,
+        'execution_authorized':False,'is_scheduled':False}
+    return bool(expected_fuel['display'] and expected_fuel['outdoor_display']
+        and hmac.compare_digest(_nova_inc051_canonical_json(fuel),
+                                _nova_inc051_canonical_json(expected_fuel)))
+
+
+def _v4891_prepare_snapshot_for_ui(data):
+    out=_INC132_CARD2_FIRST_BASE_UI(data)
+    if not isinstance(out,dict):return out
+    dual=out.get('inc132_dual_quality') or {}
+    if not isinstance(dual,dict):return out
+    integrative=dual.get('quality_integrative') or {}
+    if not isinstance(integrative,dict) or not integrative.get('complete'):
+        return out
+    result=dict(out);dual=dict(dual);integrative=dict(integrative)
+    plan=(result.get('future_quality_plan') or {}).get('inc132_integrative') or {}
+    if plan.get('dose_kind')=='FIRST_TEMPO_FTP_ADVISORY':
+        integrative['dose_label']='Range della prima esposizione (FTP Intervals personale, non prove già svolte)'
+        integrative['first_exposure']=True
+        integrative['execution_disclaimer']='Proposta futura · verifica condizione e tempi prima di eseguirla'
+    else:
+        integrative['dose_label']='Range personale da ripetizioni Tempo verificate'
+        integrative['first_exposure']=False
+    dual['quality_integrative']=integrative;result['inc132_dual_quality']=dual
+    return result
+
+# Only change a single label in Card2; Card3 markup and rendering stay intact.
+_INC132_C2_FIRST_OLD_LABEL='<b>Range personale da ripetizioni Tempo verificate:</b>'
+assert HOME_PAGE.count(_INC132_C2_FIRST_OLD_LABEL)==1,'INC132_FIRST_CARD2_LABEL_ANCHOR_DRIFT'
+HOME_PAGE=HOME_PAGE.replace(_INC132_C2_FIRST_OLD_LABEL,
+    '<b>{{ zi.dose_label|default("Range personale da ripetizioni Tempo verificate")|e }}:</b>',1)
+app.jinja_env.parse(HOME_PAGE)
+# No changed APP_VERSION/release number for test-only repair.
+
 if __name__ == "__main__":
     app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000)), debug=False)
