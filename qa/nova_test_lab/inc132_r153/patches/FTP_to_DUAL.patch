+def _inc132_tempo_events(tpl, ledger, as_of):
+    """Independent, exact-protocol, resolved activity truth; no FTP-as-dose.
+
+    This uses NO guessed duration or goal inference. A pair of *distinct* past
+    matching and already-completed Tempo exposures is mandatory. Their actual
+    power must have been in the Tempo domain relative to the event's dated FTP.
+    Neither a single threshold workout nor repeated metadata with the same
+    activity identity can prove the second exposure.
+    """
+    t = tpl if isinstance(tpl,dict) else {}
+    ev = ledger if isinstance(ledger,dict) else {}
+    if (str(t.get('work_domain') or '').upper()!='TEMPO_Z3'
+        or str(t.get('pattern') or '').upper()!='SUSTAINED'
+        or _R19696_LIBRARY_INDEX.get(str(t.get('id') or '')) != t
+        or str(t.get('goal') or '').upper() not in _INC132_DUAL_GOALS
+        or str(t.get('goal') or '').upper() in _INC132_RESEARCH_ONLY_GOALS):
+        return []
+    try:
+        current=date.fromisoformat(str(as_of)[:10])
+        reps=int(t['reps']); work=int(t['work_s']); recovery=int(t['recovery_s'])
+    except (ValueError,TypeError,KeyError,OverflowError):
+        return []
+    if not (2<=reps<=3 and 600<=work<=1200 and 180<=recovery<=600):
+        return []
+    repeated=(ev.get('repeatability') or {}).get('events') or []
+    activity_rows=ev.get('events') or []
+    if not isinstance(repeated,list) or not isinstance(activity_rows,list):
+        return []
+    # Ambiguous repeated receipts are rejected as a WHOLE identity, not only
+    # ignored after the first record. Otherwise a forged/conflicting duplicate
+    # could silently leave the first receipt eligible.
+    identity_counts={}
+    for row in repeated:
+        if isinstance(row,dict) and str(row.get('activity_id') or '').strip():
+            key=str(row['activity_id']).strip()
+            identity_counts[key]=identity_counts.get(key,0)+1
+    eligible=[]
+    for r in repeated:
+        if not isinstance(r,dict):continue
+        aid=str(r.get('activity_id') or '').strip()
+        if not aid or identity_counts.get(aid)!=1:continue
+        source=str(r.get('activity_truth_source') or '').upper()
+        if (r.get('strong') is not True
+            or source not in _INC132_TEMPO_SOURCES
+            or r.get('activity_truth_status')!='RESOLVED'
+            or r.get('recovery_observation_complete') is not True
+            or type(r.get('reps')) is not int or r['reps']!=reps
+            or not _inc132_finite_protocol_seconds(r.get('interval_secs'))
+            or abs(float(r['interval_secs'])-work)>1
+            or not _inc132_finite_protocol_seconds(r.get('recovery_secs'))
+            or abs(float(r['recovery_secs'])-recovery)>5
+            or not (r.get('recovery_pair_count')==r.get('recovery_pair_expected')==reps-1)):
+            continue
+        try:
+            when=date.fromisoformat(str(r.get('date') or '')[:10])
+            watts=float(r.get('avg_watts'))
+            ftp=float(r.get('ftp'))
+        except (ValueError,TypeError,OverflowError):
+            continue
+        if (not 0<=(current-when).days<=42 or
+            not math.isfinite(watts) or not math.isfinite(ftp)
+            or not 80<=ftp<=600 or not 70<=watts<=600
+            or not .80 <= watts/ftp <= .88):
+            continue
+        # This exact source row must also be present in the independently
+        # built training event set. A user-provided repeat entry is insufficient.
+        matched=[s for s in activity_rows if isinstance(s,dict)
+             and str(s.get('activity_id') or '')==aid
+             and s.get('event_kind')=='TRAINING'
+             and s.get('activity_truth_status')=='RESOLVED'
+             and str(s.get('activity_truth_source') or '').upper()==source
+             and str(s.get('date') or '')[:10]==when.isoformat()
+             and s.get('repeatability')==r]
+        if len(matched)!=1:continue
+        eligible.append((when.isoformat(), aid, r, watts, ftp))
+    # No multiple activities on the same day masquerading as independent
+    # confirmation. Pick a bounded, deterministic latest pair.
+    eligible.sort(key=lambda row:(row[0],row[1]),reverse=True)
+    selected=[]; days=set()
+    for row in eligible:
+        if row[0] in days:continue
+        selected.append(row);days.add(row[0])
+        if len(selected)==2:break
+    if len(selected)!=2:return []
+    # Confirm consistency of two individually observed, fully repeated Tempo
+    # sessions. The pair never authorizes a progression or a longer duration.
+    ratio=max(selected[0][3],selected[1][3])/min(selected[0][3],selected[1][3])
+    if ratio>1.10:return []
+    return selected
+
