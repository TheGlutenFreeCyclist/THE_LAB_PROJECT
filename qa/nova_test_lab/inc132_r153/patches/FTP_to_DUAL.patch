+def _inc132_priority(data,tempo,owner_id):
+    """Single conservative advisory from owner-verified specific training.
+
+    Real event records use 'family'/'quality_relevant', not goal_key or
+    work_domain. Names, mere FTP, threshold in a different family, or
+    unverified labels must never trigger the C2 recommendation. Every
+    candidate exposure is replayed against the native server truth boundary.
+    """
+    ev=(data.get('evidence_ledger') or {}).get('events') or []
+    ledger=data.get('evidence_ledger') or {}
+    families=_INC132_SPECIFIC_VERIFIED_FAMILIES.get(tempo.get('goal_key'),frozenset())
+    tempo_exposures={str(x) for x in (tempo.get('evidence_ids') or [])}
+    today=get_rome_now().date()
+    seen=set(); seen_days=set()
+    if not owner_id or not families:
+        return 'CARD3','SPECIFIC_QUALITY_REMAINS_PRIMARY'
+    for item in ev:
+        if (not isinstance(item,dict) or item.get('event_kind')!='TRAINING'
+            or item.get('family') not in families
+            or item.get('quality_relevant') is not True):continue
+        aid=str(item.get('activity_id') or '')
+        if not aid or aid in tempo_exposures or aid in seen:continue
+        if (item.get('activity_truth_status')!='RESOLVED'
+            or item.get('activity_truth_source') not in _INC132_TEMPO_SOURCES):continue
+        try:d=date.fromisoformat(str(item.get('date') or '')[:10])
+        except (ValueError,TypeError):continue
+        if not 0<=(today-d).days<=14 or d in seen_days:continue
+        repeat=item.get('repeatability')
+        if not (isinstance(repeat,dict) and repeat.get('strong') is True
+            and repeat.get('recovery_observation_complete') is True
+            and _inc132_finite_protocol_seconds(repeat.get('interval_secs'))
+            and _inc132_finite_protocol_seconds(repeat.get('recovery_secs'))):continue
+        # Labels alone are not sufficient. The source and this event must have
+        # a matching repeat receipt in the original server-built ledger.
+        band={'activity_id':aid,
+              'evidence_interval_seconds':repeat['interval_secs'],
+              'observed_recovery_seconds':repeat['recovery_secs']}
+        witness=_nova_inc091_truth(ledger,band,owner_id,producer_request=True)
+        if (not isinstance(witness,dict)
+            or witness.get('state')!='SERVER_RESOLVED_TRUTH_REPLAYED'
+            or witness.get('owner_scope')!=_nova_inc050_owner_scope(owner_id)
+            or witness.get('activity_id')!=aid):continue
+        seen.add(aid);seen_days.add(d)
+        if len(seen)>=2:
+            return 'CARD2','TWO_DISTINCT_OWNER_VERIFIED_RECENT_SPECIFIC_SESSIONS'
+    return 'CARD3','SPECIFIC_QUALITY_REMAINS_PRIMARY'
+
+
+def _inc132_validate_integrative(data,plan,owner_user_id,producer_request=True):
+    tempo=plan.get('inc132_integrative') if isinstance(plan,dict) else None
+    if not isinstance(tempo,dict):return False
+    work=tempo.get('workout') or {}
+    wid=str(tempo.get('workout_id') or '')
+    tpl=_R19696_LIBRARY_INDEX.get(wid)
+    if (tempo.get('schema')!=INC132_DUAL_SCHEMA or tempo.get('role')!='CARD2'
+        or not isinstance(tpl,dict) or tpl.get('work_domain')!='TEMPO_Z3'
+        or tempo.get('goal_key')!=plan.get('goal_key')
+        or tempo.get('dimension')!=plan.get('dimension')
+        or tempo.get('owner_scope')!=_nova_inc050_owner_scope(owner_user_id)
+        or wid==plan.get('workout_id')
+        or str(work.get('nova_workout_id') or '')!=wid
+        or not _nova_inc075_valid_compiled_duration(work)
+        or tempo.get('compiled_workout_digest')!=_nova_inc050_workout_digest(work)
+        or not _v19696_execution_contract(work).get('ready')
+        or tempo.get('no_calendar') is not True
+        or tempo.get('execution_authorized') is not False
+        or tempo.get('not_issued') is not True):return False
+    evidence=data.get('evidence_ledger') or {}
+    band=work.get('power_prescription') or {}
+    if (_nova_inc083_science_replay(work,evidence,data.get('ftp_anchor'),
+        data.get('adaptive_roadmap')).get('accepted') is not True):return False
+    truth=_inc132_tempo_server_truth(band,evidence,owner_user_id,producer_request=producer_request)
+    if not truth or tempo.get('origin_proof')!=truth:return False
+    comp=(work.get('session_composition') or {})
+    return (comp.get('total_seconds')/60==tempo.get('duration_minutes')
+            and tempo.get('evidence_ids')==[band.get('activity_id'),band.get('second_activity_id')])
+
