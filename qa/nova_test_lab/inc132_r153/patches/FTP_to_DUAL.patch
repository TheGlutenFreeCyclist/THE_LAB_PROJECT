+def _inc132_finite_protocol_seconds(value):
+    """Numeric seconds with bounded conversion (reject bool, NaN, infinity)."""
+    if type(value) not in (int,float):return False
+    try:seconds=float(value)
+    except (ValueError,TypeError,OverflowError):return False
+    return math.isfinite(seconds) and 1<=seconds<=7200
+
