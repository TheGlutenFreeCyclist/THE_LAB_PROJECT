+_INC132_SPECIFIC_VERIFIED_FAMILIES = {
+    'POWER_5':frozenset({'VO2max'}),
+    'VO2MAX':frozenset({'VO2max'}),
+    'POWER_20':frozenset({'TTE'}),
+    'TIME_TRIAL':frozenset({'TTE'}),
+    'POWER_1':frozenset({'Sprint / Neuromuscular'}),
