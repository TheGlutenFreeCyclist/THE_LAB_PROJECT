+        evidence_ledger=evidence_ledger,power_model=power_model,
+        ftp_anchor=ftp_anchor,aerobic_metabolic_range=aerobic_metabolic_range,
+        training_definitions=training_definitions,compiler_args=compiler_args,
+        planning_context=planning_context,training_state=training_state,
+        active_offer=active_offer)
+    if not isinstance(plan,dict):return plan
+    plan=dict(plan)
+    plan['inc132_dual_schema']=INC132_DUAL_SCHEMA
+    # C3 is NEVER replaced, reissued or made subordinate to the Card2 selector.
+    # Existing injury/issuer boundaries remain authoritative.
+    if (_nova_inc079_explicit_injury_restriction(planning_context)
+        or plan.get('status')!='COMPILED_UNSCHEDULED'
+        or plan.get('schema')!=INC091_SCHEMA or active_offer):
+        plan['inc132_integrative_state']='NOT_EVALUATED_WITHOUT_VERIFIED_CARD3'
+        return plan
+    candidate,why=_inc132_build_integrative(str(plan.get('goal_key') or ''),
+        str(plan.get('dimension') or ''),evidence_ledger,ftp_anchor,
+        road,power_model,owner_user_id)
+    plan['inc132_integrative_state']=why
+    if candidate is not None and candidate['workout_id']!=plan.get('workout_id'):
+        plan['inc132_integrative']=candidate
+    return plan
