+def _nova_inc051_attest_future_snapshot(data,owner_user_id):
+    plan=data.get('future_quality_plan') if isinstance(data,dict) else None
+    tempo=(plan or {}).get('inc132_integrative') if isinstance(plan,dict) else None
+    if isinstance(tempo,dict):
+        if _inc132_validate_integrative(data,plan,owner_user_id):
+            minutes=tempo['duration_minutes']
+            metabolic=data.get('metabolic_context') or {}
+            try:
+                inside=_intra_fueling_strategy('THRESHOLD','INDOOR','THRESHOLD',minutes,
+                    glycogen_pressure=metabolic.get('glycogen_pressure'),
+                    metabolic_context=metabolic)
+                outside=_intra_fueling_strategy('THRESHOLD','OUTDOOR','THRESHOLD',minutes,
+                    glycogen_pressure=metabolic.get('glycogen_pressure'),
+                    metabolic_context=metabolic)
+                if not (inside.get('display') and outside.get('display')):raise ValueError('FUEL_MISSING')
+                tempo['fueling']={'workout_id':tempo['workout_id'],
+                    'source':'EXACT_COMPILED_INTEGRATIVE_TEMPO_DURATION',
+                    'display':inside['display'],'outdoor_display':outside['display'],
+                    'total_minutes_example':minutes,'read_only':True,
+                    'execution_authorized':False,'is_scheduled':False}
+                priority,reason=_inc132_priority(data,tempo,owner_user_id)
+                plan['inc132_recommended_priority']=priority
+                plan['inc132_priority_reason']=reason
+            except (ValueError,TypeError,AttributeError,KeyError):
+                plan.pop('inc132_integrative',None)
+                plan['inc132_integrative_state']='FUELING_NOT_ATTESTED'
+        else:
+            plan.pop('inc132_integrative',None)
+            plan['inc132_integrative_state']='OWNER_OR_DOSE_ATTESTATION_FAILED'
+    return _INC132_DUAL_BEFORE_ATTEST(data,owner_user_id)
