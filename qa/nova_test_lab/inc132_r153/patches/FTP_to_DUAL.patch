+def _inc132_measured_tempo_band(tpl,evidence_ledger,as_of_date,dimension):
+    t=tpl if isinstance(tpl,dict) else {}
+    if str(dimension or '').upper() not in set(t.get('dimensions') or ()):return None
+    events=_inc132_tempo_events(t,evidence_ledger,as_of_date)
+    if len(events)!=2:return None
+    # Conservative repeat of the LOWER of two observed actual Tempo averages;
+    # never extrapolate a higher or longer load from threshold/Z4 evidence.
+    minimum=min(row[3] for row in events)
+    base=int(math.floor(minimum/5)*5)
+    low=base-5;high=base+5
+    if not (70<=low<high<=600 and all(high<=e[4]*.90 for e in events)):
+        return None
+    primary,second=events
+    proof_items=[{'activity_id':r[1], 'date':r[0],
+                  'avg_watts':r[3], 'ftp':r[4],
+                  'reps':r[2]['reps'],'work_s':r[2]['interval_secs'],
+                  'recovery_s':r[2]['recovery_secs']}
+                 for r in events]
+    digest=hashlib.sha256(_nova_inc051_canonical_json(proof_items).encode()).hexdigest()
+    return {'schema':R1943_SCHEMA,'state':'PRESCRIBED',
+        'source':'COMPARABLE_VERIFIED_REPEATED_WORK',
+        'tempo_proof_schema':INC132_TEMPO_SCHEMA,
+        'confidence':'DIRECT_OBSERVED_REPLICATION',
+        'repeatability_state':'VERIFIED_COMPARABLE_REPEATS',
+        'power_target_mode':'VERIFIED_REPEATED_TARGET',
+        'target_watts':base,'low_watts':low,'high_watts':high,
+        'reps':t['reps'],'work_seconds':t['work_s'],
+        'recovery_seconds':t['recovery_s'],
+        'observed_repeated_avg_watts':primary[3],
+        'observed_recovery_seconds':t['recovery_s'],
+        'evidence_interval_seconds':t['work_s'],
+        'recovery_duration_comparable':True,
+        'activity_id':primary[1],'activity_date':primary[0],
+        'second_activity_id':second[1],'second_activity_date':second[0],
+        'observed_dose_digest':digest,
+        'work_domain':'TEMPO_Z3','workout_specific_proof':'TWO_EXACT_VERIFIED_TEMPO_SESSIONS',
+        'no_progression':True,'non_punitive':True,
+        'execution_clearance':'SEPARATE_DOWNSTREAM'}
+
